# Reown (WalletConnect) project id from https://cloud.reown.com
VITE_REOWN_PROJECT_ID=
# Default RPC for Polygon Amoy (chainId 80002). Users can override in Settings.
VITE_DEFAULT_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
# Optional: Etherscan v2 API key for ABI lookup. Public in the bundle - use a restricted key.
VITE_EXPLORER_API_KEY=
