# --- Contracts / deployment (root) ---
# Never commit the real .env. Use a throwaway deployer key funded with Amoy POL.
DEPLOYER_PRIVATE_KEY=
AMOY_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
# Etherscan v2 key (works for Polygonscan, chainid 80002) - used for contract verification
POLYGONSCAN_API_KEY=
# Optional: block number to pin fork tests/dry-run to (empty = latest)
FORK_BLOCK_NUMBER=
